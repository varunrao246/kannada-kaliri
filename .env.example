# Supabase Authentication & PostgreSQL credentials
# Replace with your Supabase project credentials from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Gnani AI (Vachana AI) Voice Intelligence Integration (Milestone 05.1)
# Single shared API key used for both Prisma STT and Timbre TTS
GNANI_API_KEY=
GNANI_STT_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Kaveri

# AI Kannada Guru — Personalized Intelligent Tutor (Milestone 06)
# Supported providers: 'google' (Gemini), 'openai' (or OpenAI-compatible), 'groq', 'anthropic'
AI_PROVIDER=google
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=


